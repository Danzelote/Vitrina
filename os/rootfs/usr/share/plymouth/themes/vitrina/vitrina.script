// Vitrina: la ventana de 4 cuadros que "respiran" mientras arranca o se apaga.
// El mismo logo, en el mismo lugar, sigue en la app al abrirse (ui.py: draw_intro).

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

square = Image("square.png");
name = Image("name.png");

S = 38.5;   // tamaño de cada cuadro
D = 45.5;   // distancia entre cuadros (ventana de 84 x 84)
PERIOD = 3.2;
DELAY = 0.8;

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;
wx = Math.Int(cx - 42);
wy = Math.Int(cy - 70);

for (k = 0; k < 4; k++) {
    sq[k] = Sprite();
    sq[k].SetZ(10);
}
label = Sprite(name);
label.SetX(Math.Int(cx - name.GetWidth() / 2));
label.SetY(wy + 84 + 28 - 2);
label.SetZ(10);

// Esquina que no se mueve de cada cuadro (la que da al centro)
ix[0] = wx + S; iy[0] = wy + S;
ix[1] = wx + D; iy[1] = wy + S;
ix[2] = wx + D; iy[2] = wy + D;
ix[3] = wx + S; iy[3] = wy + D;

fun smooth(u) {
    return u * u * (3 - 2 * u);
}

fun scale_of(k, t) {
    local.x = t - k * DELAY + PERIOD * 4;
    local.x = local.x - Math.Int(local.x / PERIOD) * PERIOD;
    local.u = local.x / PERIOD;
    if (local.u < 0.25) return 0.9 + 0.1 * smooth(local.u / 0.25);
    if (local.u < 0.5) return 1.0 - 0.1 * smooth((local.u - 0.25) / 0.25);
    return 0.9;
}

time = 0;
fun refresh() {
    time += 1 / 50;
    for (k = 0; k < 4; k++) {
        size = S * scale_of(k, time);
        sq[k].SetImage(square.Scale(size, size));
        if (k == 0 || k == 3) x = ix[k] - size; else x = ix[k];
        if (k == 0 || k == 1) y = iy[k] - size; else y = iy[k];
        sq[k].SetX(Math.Int(x));
        sq[k].SetY(Math.Int(y));
    }
}
Plymouth.SetRefreshFunction(refresh);

// Sin textos: ni mensajes del sistema ni contraseñas (Vitrina no las pide).
fun nothing(text) { }
Plymouth.SetMessageFunction(nothing);
Plymouth.SetUpdateStatusFunction(nothing);
